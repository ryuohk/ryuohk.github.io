{
  "name": "crambot",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "build:icons": "node scripts/generate-icons.mjs",
    "dev:web": "npm run dev --workspace @crambot/web -- --host 0.0.0.0",
    "test": "npm run test --workspaces --if-present",
    "check": "npm run test && npm run build"
  },
  "devDependencies": {
    "sharp": "0.35.4",
    "typescript": "^7.0.2",
    "typescript-language-server": "^5.3.0"
  },
  "engines": {
    "node": ">=22"
  }
}
