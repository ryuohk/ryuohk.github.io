# Copy to apps/web/.env.local for local development.
#
# Both values are public by design. The anon key only reaches PostgREST, and every
# table is locked down by row level security plus the invite list, so holding this
# key grants nothing on its own. Leave both unset to run CramBot local-only, with
# no sign-in screen and no cloud sync.
#
# Find them in the Supabase dashboard under Project Settings -> API.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
